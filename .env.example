# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's already in .gitignore.

# From your Supabase project: Settings -> API
SUPABASE_URL=some thing
SUPABASE_SERVICE_KEY=ome thing

# Any secret string you choose - this gates the /admin.html page.
ADMIN_KEY=ome thing

# Optional - defaults to 3000 if not set.
PORT=3000
